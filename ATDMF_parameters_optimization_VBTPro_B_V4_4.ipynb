    "# Numba kernels\n",
    "import numba as nb\n",
    "\n",
    "@nb.njit(parallel=True)\n",
    "def rolling_median_nb(arr, window):\n",
    "    n = len(arr)\n",
    "    result = np.empty(n)\n",
    "    result[:window-1] = np.nan\n",
    "    for i in nb.prange(window-1, n):\n",
    "        window_slice = arr[i-window+1:i+1]\n",
    "        result[i] = np.median(window_slice)\n",
    "    return result\n",
    "\n",
    "@nb.njit(parallel=True)\n",
    "def sma_cross_exit_nb(close, window):\n",
    "    n = len(close)\n",
    "    sma = np.empty(n)\n",
    "    sma[:window-1] = np.nan\n",
    "    for i in nb.prange(window-1, n):\n",
    "        sma[i] = np.mean(close[i-window+1:i+1])\n",
    "    signal = np.zeros(n, dtype=np.bool_)\n",
    "    for i in nb.prange(1, n):\n",
    "        if not np.isnan(sma[i-1]) and not np.isnan(sma[i]):\n",
    "            if close[i-1] > sma[i-1] and close[i] < sma[i]:\n",
    "                signal[i] = True\n",
    "    return signal\n"
   ]
