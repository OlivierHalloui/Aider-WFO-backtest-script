    "# Performance Preflight\n",
    "import os\n",
    "import numba\n",
    "from contextlib import contextmanager\n",
    "\n",
    "# Global variables\n",
    "N_WORKERS = os.cpu_count() or 4\n",
    "LIMIT_BLAS_THREADS = 1\n",
    "USE_GPU = False  # Set to True if GPU backend is available (e.g., CuPy)\n",
    "NUMBA_PARALLEL = True\n",
    "\n",
    "# Configure BLAS limits\n",
    "os.environ['OPENBLAS_NUM_THREADS'] = str(LIMIT_BLAS_THREADS)\n",
    "os.environ['MKL_NUM_THREADS'] = str(LIMIT_BLAS_THREADS)\n",
    "os.environ['NUMEXPR_NUM_THREADS'] = str(LIMIT_BLAS_THREADS)\n",
    "os.environ['OMP_NUM_THREADS'] = str(LIMIT_BLAS_THREADS)\n",
    "\n",
    "# Set Numba threads\n",
    "numba.set_num_threads(LIMIT_BLAS_THREADS)\n",
    "\n",
    "# Context manager for limiting BLAS threads\n",
    "@contextmanager\n",
    "def limit_blas_threads(n_threads=1):\n",
    "    original_values = {}\n",
    "    env_vars = ['OPENBLAS_NUM_THREADS', 'MKL_NUM_THREADS', 'NUMEXPR_NUM_THREADS', 'OMP_NUM_THREADS']\n",
    "    for var in env_vars:\n",
    "        original_values[var] = os.environ.get(var)\n",
    "        os.environ[var] = str(n_threads)\n",
    "    try:\n",
    "        yield\n",
    "    finally:\n",
    "        for var, val in original_values.items():\n",
    "            if val is not None:\n",
    "                os.environ[var] = val\n",
    "            else:\n",
    "                os.environ.pop(var, None)\n"
   ]
