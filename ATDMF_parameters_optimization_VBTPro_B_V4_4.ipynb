    "#     mediane = pd.Series(ecart_borne1).rolling(longueur_mediane).median()/coef_mediane\n",
    "#     # df['Ecart_Bollinger_borne_signal']  = (pd.Series(ecart_borne1).shift(6) < rolling_median).astype(int)\n",
    "#     Ecart_Bollinger_borne_signal = (pd.Series(ecart_borne1).shift(6) < mediane)\n",
    "#     return Ecart_Bollinger_borne_signal\n",
    "\n",
    "# Ecart_Bollinger_borne_signal= Ecart_Bollinger_borne()\n",
    "# print(Ecart_Bollinger_borne_signal)\n",
    "\n",
    "# Ecart_Bollinger_borne Indicator (modifié pour correspondre à Pine Script)\n",
    "def Ecart_Bollinger_borne(Prix, timeperiod, StDev, longueur_mediane, coef_mediane, upper_band, lower_band,  Nb_bars_above):\n",
    "    ecart = upper_band - lower_band\n",
    "    ecart_borne1 = ecart / talib.SMA(Prix, timeperiod)\n",
    "    moyenne_ecart = talib.SMA(ecart_borne1,7)\n",
    "    mediane = rolling_median_nb(ecart_borne1, longueur_mediane) / coef_mediane\n",
    "    below_median = pd.Series(ecart_borne1 < mediane)\n",
    "    bars_since_below = pd.Series(np.nan, index=below_median.index)\n",
    "    counter = np.inf\n",
    "    for i in range(len(below_median)):\n",
    "        if below_median.iloc[i]:\n",
    "            counter = 0\n",
    "        else:\n",
    "            counter += 1\n",
    "        bars_since_below.iloc[i] = counter\n",
    "    Ecart_Bollinger_borne_signal = bars_since_below >= Nb_bars_above \n",
    "    return Ecart_Bollinger_borne_signal\n",
    "\n",
    "# # bollinger_horizontal_v3 Indicator\n",
    "def bollinger_horizontal_v3(Prix, coeff_medianeBBW, StDev, timeperiod, upper_band, lower_band, middle_band):\n",
    "    BBW = (upper_band - lower_band) / middle_band\n",
    "    MMBBW = BBW.rolling(window=5).mean()\n",
    "    medianeBBW = rolling_median_nb(BBW.values, 200)\n",
    "    seuilBBW = BBW < (medianeBBW / coeff_medianeBBW)\n",
    "    seuilMMBBW = MMBBW < (medianeBBW / coeff_medianeBBW)\n",
    "    bollingerHorizontal_signal = np.where(seuilBBW | seuilMMBBW, 1, 0)\n",
    "    return bollingerHorizontal_signal\n",
    "\n",
    "# CrossBBWLowSignal Indicator\n",
    "def CrossBBWLowSignal(Prix, timeperiod, StDev, fenetre_lowest, seuil_lowest):\n",
    "    largeur_bb = (upper_band - lower_band)/middle_band\n",
    "    # bbw_lowest = talib.MIN(largeur_bb, timeperiod=fenetre_lowest)\n",
    "    # Calculer le minimum sur une fenêtre glissante de taille fenetre_lowest sans utiliser TA-Lib\n",
    "    bbw_lowest = pd.Series(largeur_bb).rolling(window=fenetre_lowest, min_periods=fenetre_lowest).min()\n",
    "    bbw_lowest_signal = largeur_bb <= (bbw_lowest * seuil_lowest)\n",
    "    return bbw_lowest_signal\n"
   ]
