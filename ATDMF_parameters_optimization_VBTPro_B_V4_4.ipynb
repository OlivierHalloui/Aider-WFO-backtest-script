    "# Interactive objective metric selection\n",
    "import ipywidgets as widgets\n",
    "from IPython.display import display\n",
    "\n",
    "metric_labels = {\n",
    "    'max_drawdown': 'Max drawdown',\n",
    "    'sharpe_ratio': 'Sharpe ratio',\n",
    "    'total_return': 'Total return',\n",
    "    'avg_gain_per_trade': 'Average gain per trade',\n",
    "    'avg_loss_per_trade': 'Average loss per trade',\n",
    "    'win_rate': 'Win rate',\n",
    "}\n",
    "\n",
    "metric1_dropdown = widgets.Dropdown(options=list(metric_labels.keys()), value='max_drawdown', description='Métrique 1')\n",
    "metric2_dropdown = widgets.Dropdown(options=list(metric_labels.keys()), value='sharpe_ratio', description='Métrique 2')\n",
    "weight_slider = widgets.FloatSlider(min=0.0, max=1.0, step=0.05, value=0.5, description='Poids métrique 1')\n",
    "apply_metrics_button = widgets.Button(description='Appliquer les métriques', button_style='primary')\n",
    "metrics_output = widgets.Output()\n",
    "\n",
    "\n",
    "def ensure_distinct(change):\n",
    "    if metric1_dropdown.value == metric2_dropdown.value:\n",
    "        for key in metric_labels:\n",
    "            if key != metric1_dropdown.value:\n",
    "                metric2_dropdown.value = key\n",
    "                break\n",
    "\n",
    "\n",
    "metric1_dropdown.observe(ensure_distinct, names='value')\n",
    "\n",
    "\n",
    "def apply_metrics_settings(_=None):\n",
    "    global selected_metric_1, selected_metric_2, weight_metric1, weight_metric2\n",
    "    selected_metric_1 = metric1_dropdown.value\n",
    "    selected_metric_2 = metric2_dropdown.value\n",
    "    if selected_metric_1 == selected_metric_2:\n",
    "        ensure_distinct(None)\n",
    "        selected_metric_2 = metric2_dropdown.value\n",
    "    weight_metric1 = round(weight_slider.value, 2)\n",
    "    weight_metric2 = round(1 - weight_metric1, 2)\n",
    "    with metrics_output:\n",
    "        metrics_output.clear_output()\n",
    "        display(widgets.HTML(\n",
    "            f\"<b>Métriques appliquées :</b> {metric_labels[selected_metric_1]} (poids {weight_metric1}) / {metric_labels[selected_metric_2]} (poids {weight_metric2})\"\n",
    "        ))\n",
    "\n",
    "\n",
    "apply_metrics_button.on_click(apply_metrics_settings)\n",
    "\n",
    "metrics_ui = widgets.VBox([\n",
    "    widgets.HTML('<h4>Critères d\\'optimisation</h4>'),\n",
    "    metric1_dropdown,\n",
    "    metric2_dropdown,\n",
    "    weight_slider,\n",
    "    apply_metrics_button,\n",
    "    metrics_output,\n",
    "])\n",
    "\n",
    "display(metrics_ui)\n",
    "apply_metrics_settings()\n",
    "\n"
   ]
