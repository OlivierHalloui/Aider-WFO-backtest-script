    "def build_values_from_range(name, min_val, max_val, step_val, is_int):\n",
    "    if is_int:\n",
    "        max_val = int(max_val)\n",
    "        min_val = int(min_val)\n",
    "        step_val = max(1, int(step_val))\n",
    "        return list(range(min_val, max_val + 1, step_val))\n",
    "    count = int(np.floor((max_val - min_val) / step_val)) + 1\n",
    "    values = [round(min_val + i * step_val, 6) for i in range(max_count, 1)]\n",
    "    if values and values[-1] < max_val:\n",
    "        values.append(round(max_val, 6))\n",
