    "def calculate_exit_sma(Prix, user_exit_sma_length):\n",
    "    return sma_cross_exit_nb(Prix.values, user_exit_sma_length)\n",
    "\n",
    "def calculate_exit_SAR(df, Prix):\n",
    "    \"\"\"\n",
    "    Calcule le signal de sortie basé sur l'indicateur Parabolic SAR.\n",
    "    \n",
    "    Le signal est ajouté au DataFrame sous la colonne 'exit_SAR_signal'.\n",
    "    \n",
    "    Parameters:\n",
    "        df (pandas.DataFrame): Le DataFrame contenant les données (colonnes 'High', 'Low', etc.).\n",
    "        Prix (pandas.Series): La série de prix de clôture (utilisée pour les conditions).\n",
    "    \n",
    "    Returns:\n",
    "        df (pandas.DataFrame): Le DataFrame mis à jour avec la colonne de signal SAR.\n",
    "    \"\"\"\n",
    "    sar = ta.SAR(High, Low, acceleration=0.2, maximum=0.2)\n",
    "    df['exit_SAR_signal'] = np.where(\n",
    "        (Prix.shift(1) > sar.shift(1)) & (Prix < sar), 1, 0\n",
    "    )\n",
    "    return df\n",
    "\n",
    "# Calcul et affichage du signal SAR\n",
    "df = calculate_exit_SAR(df, Prix)\n",
    "print(\"\\nDataFrame après calcul du signal SAR de sortie :\")\n",
    "print(df.head())\n",
    "\n",
    "\n",
    "# BBANDS = IndicatorFactory.from_talib('BBANDS')\n",
    "bollinger = vbt.BBANDS.run(close=Prix,window=timeperiod,wtype=matype, alpha = StDev)\n",
    "upper_band = bollinger.upper\n",
    "lower_band = bollinger.lower\n",
