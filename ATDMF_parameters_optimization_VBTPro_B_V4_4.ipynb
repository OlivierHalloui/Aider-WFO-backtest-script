    "local_df_V3A_3 = df.copy()\n",
    "\n",
    "\n",
    "# ________________________# Fonction A V3A_3_________________________________________________________________\n",
    "\n",
    "def objectiveV3A_3(local_df_V3A_3, timeframe=timeframe_agg, return_portfolio=False, **params):\n",
    "    # Extraction des paramètres avec valeurs par défaut\n",
    "    timeperiod = params.get('timeperiod', 20)\n",
    "    StDev = params.get('StDev', 2.1)\n",
    "    alpha = StDev\n",
    "    wtype = params.get('wtype', 'simple')\n",
    "    coeff_medianeBBW = params.get('coeff_medianeBBW', 1.1)\n",
    "    coef_mediane = params.get('coef_mediane', 1.0)\n",
    "    Nb_bars_above = params.get('Nb_bars_above', 1)\n",
    "    fenetre_lowest = params.get('fenetre_lowest', 30)\n",
    "    seuil_lowest = params.get('seuil_lowest', 3.5)\n",
    "    user_exit_sma_length = params.get('user_exit_sma_length', timeperiod)   \n",
    "    # Mapping des types de moyennes mobiles pour TA-Lib\n",
    "    matype_mapping = {\n",
    "        'simple': 0,\n",
    "        'exponential': 1,\n",
    "        'weighted': 2,\n",
    "        'dema': 3,\n",
    "        'tema': 4,\n",
    "        'trima': 5,\n",
    "        'kama': 6,\n",
    "        'mama': 7,\n",
    "        't3': 8\n",
    "    }\n",
    "    matype = matype_mapping.get(wtype, 0)\n",
    "    Prix = local_df_V3A_3['Close']\n",
    "    # Calcul des Bandes de Bollinger\n",
    "    upper_band, middle_band, lower_band = ta.BBANDS(Prix, timeperiod, StDev, StDev, matype)\n",
    "    \n",
    "    # Calcul des signaux\n",
    "    local_df_V3A_3['bollingerHorizontal_signal'] = bollinger_horizontal_v3(Prix, coeff_medianeBBW, StDev, timeperiod, upper_band, lower_band, middle_band )\n",
    "    local_df_V3A_3['Ecart_Bollinger_borne_signal'] = Ecart_Bollinger_borne(Prix, timeperiod, StDev, longueur_mediane, coef_mediane, upper_band, lower_band, Nb_bars_above)\n",
    "    local_df_V3A_3['bbw_lowest_signal'] = CrossBBWLowSignal(Prix, timeperiod, StDev, fenetre_lowest, seuil_lowest)\n",
    "    local_df_V3A_3['SMA_exit_signal'] = calculate_exit_sma(Prix, user_exit_sma_length)\n",
    "    \n",
    "    # Conditions d'entrée et de sortie\n",
    "    entry_condition = (\n",
    "        #(local_df_V3A_3['bbw_lowest_signal']) &\n",
    "        (local_df_V3A_3['Ecart_Bollinger_borne_signal']) &\n",
    "        # (local_df_V3A_3['bollingerHorizontal_signal']) &\n",
    "        (Prix > upper_band) & \n",
    "        (Prix.shift(1) < upper_band.shift(1))\n",
    "        # & (Prix > High.shift(1))\n",
    "    )   \n",
    "    exit_condition = (local_df_V3A_3['SMA_exit_signal'] == True)\n",
    "    \n",
    "    # # Création du portefeuille à partir des ordres\n",
    "    # portfolio = vbt.Portfolio.from_orders(\n",
    "    #     close=Prix,\n",
    "    #     size=orders_size,\n",
    "    #     size_type='value',\n",
    "    #     price=orders_price,\n",
    "    #     ffill_val_price=False,\n",
    "    #     init_cash=10000,\n",
    "    #     fees=0.0,\n",
    "    #     freq=timeframe\n",
    "    # )\n",
    "\n",
    "    # Création du portefeuille\n",
    "    portfolio = vbt.Portfolio.from_signals(\n",
    "        close=Prix,\n",
    "        ffill_val_price=False,\n",
    "        entries=entry_condition,\n",
    "        exits=exit_condition,\n",
    "        init_cash=10000,\n",
    "        fees=0.0,\n",
    "        freq=timeframe_agg\n",
    "    )\n",
    "    \n",
    "    # Calcul des métriques brutes pour chaque critère sélectionné\n",
    "    # (On applique *100 à max_drawdown pour avoir des valeurs comparables)\n",
    "    if selected_metric_1 == 'max_drawdown':\n",
    "        metric1 = portfolio.max_drawdown *100\n",
    "    elif selected_metric_1 == 'sharpe_ratio':\n",
    "        metric1 = portfolio.sharpe_ratio\n",
    "    elif selected_metric_1 == 'total_return':\n",
    "        metric1 = portfolio.total_return *100\n",
    "    elif selected_metric_1 == 'avg_gain_per_trade':\n",
    "        metric1 = portfolio.average_gain_per_trade\n",
    "    elif selected_metric_1 == 'avg_loss_per_trade':\n",
    "        metric1 = portfolio.average_loss_per_trade\n",
    "    elif selected_metric_1 == 'win_rate':\n",
    "        metric1 = portfolio.win_rate\n",
    "    else:\n",
    "        metric1 = portfolio.max_drawdown *100 # valeur par défaut\n",
    "\n",
    "    if selected_metric_2 == 'max_drawdown':\n",
    "        metric2 = portfolio.max_drawdown *100\n",
    "    elif selected_metric_2 == 'sharpe_ratio':\n",
    "        metric2 = portfolio.sharpe_ratio\n",
    "    elif selected_metric_2 == 'total_return':\n",
    "        metric2 = portfolio.total_return * 100\n",
    "    elif selected_metric_2 == 'avg_gain_per_trade':\n",
    "        metric2 = portfolio.average_gain_per_trade\n",
    "    elif selected_metric_2 == 'avg_loss_per_trade':\n",
    "        metric2 = portfolio.average_loss_per_trade\n",
    "    elif selected_metric_2 == 'win_rate':\n",
    "        metric2 = portfolio.win_rate\n",
    "    else:\n",
    "        metric2 = portfolio.max_drawdown *100  # valeur par défaut\n",
    "\n",
    "    # Calcul de la métrique combinée en faisant une moyenne pondérée\n",
    "    combined_metric = ((weight_metric1 * metric1) + (weight_metric2 * metric2)) / (weight_metric1 + weight_metric2)\n",
    "    \n",
    "    if return_portfolio:\n",
    "        return portfolio\n",
    "    else:\n",
    "        return combined_metric"
