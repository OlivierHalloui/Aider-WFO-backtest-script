    "# def Ecart_Bollinger_borne(Prix = Prix, timeperiod, StDev=StDev, longueur_mediane=longueur_mediane, coef_mediane=coef_mediane,upper_band = upper_band, lower_band = lower_band, middle_band = middle_band ):\n",
    "#     # upper_band, middle_band, lower_band = talib.BBANDS(close, timeperiod=timeperiod, nbdevup=nbdevup, nbdevdn=nbdevdn)\n",
    "#     ecart = upper_band - lower_band\n",
